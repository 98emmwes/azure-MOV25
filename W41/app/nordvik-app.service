[Unit]
Description=Nordvik felanmalan (Flask via gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/nordvik
EnvironmentFile=/etc/nordvik-app.env
ExecStart=/opt/nordvik/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:5000 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
